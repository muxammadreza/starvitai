NODE_ENV=development
STARVIT_ENV=dev

# ==========================================
# Starvit Local Development Environment
# Copy this to .env.local and fill in your credentials
# ==========================================

# --- Backend API Mode ---
STARVIT_MODE=stub

# --- Frontend Public URLs ---
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- Medplum (Auth + FHIR) ---
MEDPLUM_BASE_URL=https://api.medplum.starvit.ca
MEDPLUM_FHIR_BASE_URL=https://api.medplum.starvit.ca/fhir/R4
MEDPLUM_OAUTH_TOKEN_URL=https://api.medplum.starvit.ca/oauth2/token
MEDPLUM_AUTH_ME_URL=https://api.medplum.starvit.ca/auth/me

# ClientApplication clientId for clinician + research web apps
MEDPLUM_FRONTEND_CLIENT_ID=<medplum-web-client-id>

# Backend service credentials (server-to-server)
MEDPLUM_BACKEND_CLIENT_ID=<backend-client-id>
MEDPLUM_BACKEND_CLIENT_SECRET=<backend-client-secret>
