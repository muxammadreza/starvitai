  "components": {
    "schemas": {
      "DerivedMetricPoint": {
        "properties": {
          "measurementId": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Measurementid"
          },
          "measuredAt": {
            "type": "string",
            "format": "date-time",
            "title": "Measuredat"
          },
          "gki": {
            "$ref": "#/components/schemas/MeasurementQuantity"
          },
          "derivedObservationId": {
            "type": "string",
            "title": "Derivedobservationid"
          },
          "sourceObservationIds": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Sourceobservationids"
          }
        },
        "type": "object",
        "required": [
          "measurementId",
          "measuredAt",
          "gki",
          "derivedObservationId",
          "sourceObservationIds"
        ],
        "title": "DerivedMetricPoint"
      },
      "DerivedMetricsTrendResponse": {
        "properties": {
          "patientId": {
            "type": "string",
            "title": "Patientid"
          },
          "metric": {
            "type": "string",
            "title": "Metric"
          },
          "points": {
            "items": {
              "$ref": "#/components/schemas/DerivedMetricPoint"
            },
            "type": "array",
            "title": "Points"
          },
          "mode": {
            "type": "string",
            "title": "Mode"
          }
        },
        "type": "object",
        "required": [
          "patientId",
          "metric",
          "points",
          "mode"
        ],
        "title": "DerivedMetricsTrendResponse"
      },
      "GraphQuerySync": {
        "properties": {
          "query": {
            "type": "string",
            "title": "Query"
          },
          "params": {
            "additionalProperties": true,
            "type": "object",
            "title": "Params"
          }
        },
        "type": "object",
        "required": [
          "query",
          "params"
        ],
        "title": "GraphQuerySync"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "MeasurementInput": {
        "properties": {
          "patientId": {
            "type": "string",
            "minLength": 1,
            "title": "Patientid"
          },
          "measuredAt": {
            "type": "string",
            "format": "date-time",
            "title": "Measuredat"
          },
          "glucose": {
            "$ref": "#/components/schemas/MeasurementQuantity"
          },
          "ketones": {
            "$ref": "#/components/schemas/MeasurementQuantity"
          },
          "weight": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/MeasurementQuantity"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "type": "object",
        "required": [
          "patientId",
          "measuredAt",
          "glucose",
          "ketones"
        ],
        "title": "MeasurementInput"
      },
      "MeasurementObservationIds": {
        "properties": {
          "glucose": {
            "type": "string",
            "title": "Glucose"
          },
          "ketones": {
            "type": "string",
            "title": "Ketones"
          },
          "weight": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Weight"
          }
        },
        "type": "object",
        "required": [
          "glucose",
          "ketones"
        ],
        "title": "MeasurementObservationIds"
      },
      "MeasurementQuantity": {
        "properties": {
          "value": {
            "type": "number",
            "exclusiveMinimum": 0.0,
            "title": "Value"
          },
          "unit": {
            "type": "string",
            "title": "Unit"
          }
        },
        "type": "object",
        "required": [
          "value",
          "unit"
        ],
        "title": "MeasurementQuantity"
      },
      "MeasurementRecord": {
        "properties": {
          "measurementId": {
            "type": "string",
            "title": "Measurementid"
          },
          "measuredAt": {
            "type": "string",
            "format": "date-time",
            "title": "Measuredat"
          },
          "glucose": {
            "$ref": "#/components/schemas/MeasurementQuantity"
          },
          "ketones": {
            "$ref": "#/components/schemas/MeasurementQuantity"
          },
          "weight": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/MeasurementQuantity"
              },
              {
                "type": "null"
              }
            ]
          },
          "observationIds": {
            "$ref": "#/components/schemas/MeasurementObservationIds"
          }
        },
        "type": "object",
        "required": [
          "measurementId",
          "measuredAt",
          "glucose",
          "ketones",
          "observationIds"
        ],
        "title": "MeasurementRecord"
      },
      "MeasurementWriteResponse": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status"
          },
          "measurementId": {
            "type": "string",
            "title": "Measurementid"
          },
          "patientId": {
            "type": "string",
            "title": "Patientid"
          },
          "measuredAt": {
            "type": "string",
            "format": "date-time",
            "title": "Measuredat"
          },
          "observationIds": {
            "$ref": "#/components/schemas/MeasurementObservationIds"
          },
          "gkiObservationId": {
            "type": "string",
            "title": "Gkiobservationid"
          },
          "mode": {
            "type": "string",
            "title": "Mode"
          }
        },
        "type": "object",
        "required": [
          "status",
          "measurementId",
          "patientId",
          "measuredAt",
          "observationIds",
          "gkiObservationId",
          "mode"
        ],
        "title": "MeasurementWriteResponse"
      },
      "RecentMeasurementsResponse": {
        "properties": {
          "patientId": {
            "type": "string",
            "title": "Patientid"
          },
          "measurements": {
            "items": {
              "$ref": "#/components/schemas/MeasurementRecord"
            },
            "type": "array",
            "title": "Measurements"
          },
          "mode": {
            "type": "string",
            "title": "Mode"
          }
        },
        "type": "object",
        "required": [
          "patientId",
          "measurements",
          "mode"
        ],
        "title": "RecentMeasurementsResponse"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
}