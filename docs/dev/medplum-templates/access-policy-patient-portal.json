{
  "resourceType": "AccessPolicy",
  "meta": {
    "project": "{{PROJECT_ID}}"
  },
  "name": "PatientPortalPolicy",
  "resource": [
    {
      "resourceType": "Patient",
      "criteria": "Patient?_id=%profile.id",
      "interaction": ["read", "search", "update"]
    },
    {
      "resourceType": "Observation",
      "criteria": "Observation?_compartment=%profile",
      "interaction": ["read", "search", "create", "update"]
    },
    {
      "resourceType": "Encounter",
      "criteria": "Encounter?_compartment=%profile",
      "interaction": ["read", "search"]
    }
  ]
}
